{
  "name": "familiweave",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "inner:storyboard": "tsx scripts/inner-storyboard.ts",
    "measure:build": "tsx scripts/measure-baseline.ts",
    "check:symbolic-path": "tsx scripts/check-symbolic-path.ts",
    "measure:browser": "tsx scripts/measure-browser.ts",
    "measure:browser:full": "tsx scripts/measure-browser.ts --full",
    "eval:validate": "cargo run -q --manifest-path rust/Cargo.toml -p familiweave-ops -- eval-validate",
    "capture:hash": "cargo run -q --manifest-path rust/Cargo.toml -p familiweave-ops -- capture-hash",
    "capture:verify": "cargo run -q --manifest-path rust/Cargo.toml -p familiweave-ops -- capture-verify",
    "genie:status": "cargo run -q --manifest-path rust/Cargo.toml -p familiweave-ops -- genie-status",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
